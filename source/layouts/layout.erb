<%#
  The HTML shell wrapped around every page: <head> meta tags, Bootstrap,
  stylesheets, and the scripts. Page content is injected at `yield`.
-%>
<!doctype html>
<%
  # Absolute URL for the social share image. Open Graph requires an absolute
  # URL — a relative path will not render a preview card.
  og = data.site.open_graph
  og_image_url = "#{data.site.url}/#{og.image}"
  og_title = og.title.to_s.empty? ? data.site.title : og.title
  og_description = og.description.to_s.empty? ? data.site.description : og.description
-%>
<html lang="en" data-bs-theme="light">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title><%= data.site.title %></title>
    <meta name="description" content="<%= data.site.description.strip %>">
    <meta name="author" content="<%= data.about.name %>">
    <link rel="canonical" href="<%= data.site.url %>">

    <%# --- Open Graph / social share cards --- %>
    <meta property="og:type" content="<%= og.type %>">
    <meta property="og:title" content="<%= og_title %>">
    <meta property="og:description" content="<%= og_description.strip %>">
    <meta property="og:image" content="<%= og_image_url %>">
    <meta property="og:url" content="<%= data.site.url %>">
    <meta property="og:site_name" content="<%= data.about.name %>">

    <%# Twitter/X reads these; summary_large_image gives the full-width card. %>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= og_title %>">
    <meta name="twitter:description" content="<%= og_description.strip %>">
    <meta name="twitter:image" content="<%= og_image_url %>">

    <%# --- Favicon --- %>
    <link rel="icon" href="<%= image_path("favicon.svg") %>" type="image/svg+xml">
    <link rel="apple-touch-icon" href="<%= image_path("favicon.svg") %>">

    <%# --- Font Awesome 6 icons from CDN --- %>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.7.2/css/all.min.css"
      crossorigin="anonymous">

    <%# --- Typed JS CDN --- %>
    <script src="https://unpkg.com/typed.js@3.0.0/dist/typed.umd.js"></script>

    <%#
      Apply the saved theme BEFORE the browser paints. If this ran at the end
      of the body instead, a user who prefers dark mode would see a white
      flash on every page load.
    -%>
    <script>
      (function () {
        // Marks that JavaScript is running. The scroll entrance animations are
        // scoped to .js in the CSS, so if this script never runs the content
        // renders plainly visible instead of staying faded out forever.
        document.documentElement.classList.add("js");

        try {
          var saved = localStorage.getItem("theme");
          var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.setAttribute(
            "data-bs-theme",
            saved || (prefersDark ? "dark" : "light")
          );
        } catch (e) {
          /* localStorage can throw in private mode — fall back to light. */
        }
      })();
    </script>

    <%# --- Bootstrap 5.3 from CDN, integrity-checked --- %>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous">

    <%# --- Our styles: theme tokens first, then everything built on them --- %>
    <%= stylesheet_link_tag "theme", "site" %>
  </head>

  <body>

    <%# Lets keyboard users jump straight past the nav to the content. %>
    <a class="skip-link" href="#main">Skip to main content</a>

    <%= partial "partials/nav" %>

    <main id="main">
      <%= yield %>
    </main>

    <%= partial "partials/footer" %>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"></script>
    <%= javascript_include_tag "theme-toggle", "scroll", "typed" %>
  </body>
</html>
