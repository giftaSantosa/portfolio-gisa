<%#
  Projects grid. Reads data/projects.yml.

  Featured projects are sorted to the front and given an accent border plus a
  badge. `sort_by` with false==0 / true==1 puts featured first; the index keeps
  the sort stable so projects otherwise stay in the order written in the YAML.
-%>
<%
  projects = data.projects.each_with_index.sort_by { |project, i| [project.featured ? 0 : 1, i] }
                                          .map(&:first)
-%>
<section id="projects" class="section section-alt">
  <div class="container">
    <p class="section-eyebrow reveal" data-reveal>02 — Projects</p>
    <h2 class="section-title reveal" data-reveal>Selected work</h2>
    <p class="section-intro reveal" data-reveal>
      A few things I've built recently. Every one of them has its source
      available!
    </p>

    <div class="row g-4">
      <% projects.each_with_index do |project, index| %>
        <div class="col-md-6">
          <article class="project-card reveal <%= "is-featured" if project.featured %>" data-reveal>

            <% if project.featured %>
              <p class="featured-badge">
                <svg class="icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false">
                  <path d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.283.95l-3.523 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256Z"/>
                </svg>
                Featured
              </p>
            <% end %>

            <%#
              Screenshot area. While `images` is empty in projects.yml this
              renders as an empty tinted block that just holds the card's
              shape — no <img>, no broken-image icon, and nothing announced to
              screen readers. One image renders as a plain picture; two or
              more become a Bootstrap carousel with arrows and indicators.
              There is no data-bs-ride, so it never autoplays — it only moves
              when the visitor clicks, swipes, or uses the arrow keys.
            -%>
            <%
              slides = project.images.to_a.reject { |slide| slide.src.to_s.empty? }
              carousel_id = "project-carousel-#{index}"
            -%>
            <% if slides.empty? %>
              <div class="project-thumb project-thumb-empty" aria-hidden="true"></div>
            <% else %>
              <div class="project-thumb">
                <div id="<%= carousel_id %>" class="carousel slide h-100">
                  <% if slides.size > 1 %>
                    <div class="carousel-indicators">
                      <% slides.each_index do |i| %>
                        <button type="button"
                                data-bs-target="#<%= carousel_id %>"
                                data-bs-slide-to="<%= i %>"
                                <%= 'class="active" aria-current="true"' if i.zero? %>
                                aria-label="<%= project.title %> screenshot <%= i + 1 %>"></button>
                      <% end %>
                    </div>
                  <% end %>

                  <div class="carousel-inner h-100">
                    <% slides.each_with_index do |slide, i| %>
                      <div class="carousel-item h-100 <%= "active" if i.zero? %>">
                        <img
                          src="<%= image_path(slide.src.sub(%r{\Aimages/}, "")) %>"
                          alt="<%= slide.alt.to_s.empty? ? "Screenshot #{i + 1} of #{project.title}" : slide.alt %>"
                          loading="lazy"
                          width="800"
                          height="450">
                      </div>
                    <% end %>
                  </div>

                  <% if slides.size > 1 %>
                    <button class="carousel-control-prev" type="button" data-bs-target="#<%= carousel_id %>" data-bs-slide="prev">
                      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                      <span class="visually-hidden">Previous <%= project.title %> screenshot</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#<%= carousel_id %>" data-bs-slide="next">
                      <span class="carousel-control-next-icon" aria-hidden="true"></span>
                      <span class="visually-hidden">Next <%= project.title %> screenshot</span>
                    </button>
                  <% end %>
                </div>
              </div>
            <% end %>

            <div class="project-body">
              <div class="project-head">
                <%#
                  With a case study, the title is a "stretched link": its
                  ::after covers the whole card, so clicking anywhere opens
                  the case study. A real wrapping <a> isn't possible because
                  the card already contains links and carousel buttons (links
                  can't nest); those are lifted above the overlay in site.css.
                -%>
                <h3 class="project-title">
                  <% if project.case_study.to_s.empty? %>
                    <%= project.title %>
                  <% else %>
                    <a class="project-title-link" href="<%= url_for(project.case_study) %>"><%= project.title %></a>
                  <% end %>
                </h3>
                <% unless project.year.to_s.empty? %>
                  <span class="project-year"><%= project.year %></span>
                <% end %>
              </div>

              <p class="project-description"><%= project.description.strip %></p>

              <ul class="tag-list tag-list-sm" role="list">
                <% project.tags.each do |tag| %>
                  <li class="tag"><%= tag %></li>
                <% end %>
              </ul>

              <div class="project-links">
                <%#
                  Case study link, only when `case_study` is set in
                  projects.yml. It's an internal page, so no new tab; url_for
                  keeps the path relative for the /portfolio/ sub-path.
                -%>
                <% unless project.case_study.to_s.empty? %>
                  <a class="project-link"
                     href="<%= url_for(project.case_study) %>"
                     aria-label="Read the <%= project.title %> case study">
                    <svg class="icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false">
                      <path d="M1 2.828c.885-.37 2.154-.769 3.388-.893 1.33-.134 2.458.063 3.112.752v9.746c-.935-.53-2.12-.603-3.213-.493-1.18.12-2.37.461-3.287.811V2.828zm7.5-.141c.654-.689 1.782-.886 3.112-.752 1.234.124 2.503.523 3.388.893v9.923c-.918-.35-2.107-.692-3.287-.81-1.094-.111-2.278-.039-3.213.492V2.687zM8 1.783C7.015.936 5.587.81 4.287.94c-1.514.153-3.042.672-3.994 1.105A.5.5 0 0 0 0 2.5v11a.5.5 0 0 0 .707.455c.882-.4 2.303-.881 3.68-1.02 1.409-.142 2.59.087 3.223.877a.5.5 0 0 0 .78 0c.633-.79 1.814-1.019 3.222-.877 1.378.139 2.8.62 3.681 1.02A.5.5 0 0 0 16 13.5v-11a.5.5 0 0 0-.293-.455c-.952-.433-2.48-.952-3.994-1.105C10.413.809 8.985.936 8 1.783z"/>
                    </svg>
                    Case study
                  </a>
                <% end %>

                <%# All external links get target=_blank + rel=noopener noreferrer. %>
                <a class="project-link"
                   href="<%= project.repo %>"
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label="<%= project.title %> source code on GitHub (opens in a new tab)">
                  <%= partial "partials/icon", locals: { name: "github" } %>
                  Source
                </a>

                <%# The demo button only renders when a demo URL is present. %>
                <% unless project.demo.to_s.empty? %>
                  <a class="project-link"
                     href="<%= project.demo %>"
                     target="_blank"
                     rel="noopener noreferrer"
                     aria-label="<%= project.title %> live demo (opens in a new tab)">
                    <svg class="icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false">
                      <path d="M8.636 3.5a.5.5 0 0 0-.5-.5H1.5A1.5 1.5 0 0 0 0 4.5v10A1.5 1.5 0 0 0 1.5 16h10a1.5 1.5 0 0 0 1.5-1.5V7.864a.5.5 0 0 0-1 0V14.5a.5.5 0 0 1-.5.5h-10a.5.5 0 0 1-.5-.5v-10a.5.5 0 0 1 .5-.5h6.636a.5.5 0 0 0 .5-.5Z"/>
                      <path d="M16 .5a.5.5 0 0 0-.5-.5h-5a.5.5 0 0 0 0 1h3.793L6.146 9.146a.5.5 0 1 0 .708.708L15 1.707V5.5a.5.5 0 0 0 1 0v-5Z"/>
                    </svg>
                    Live demo
                  </a>
                <% end %>
              </div>
            </div>

          </article>
        </div>
      <% end %>
    </div>
  </div>
</section>
