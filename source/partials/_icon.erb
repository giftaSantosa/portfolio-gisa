<%#
  Inline SVG icon set. No icon library or extra dependency — each icon is a
  path drawn directly into the page, so it inherits the current text colour
  and scales cleanly.

  Render one by passing a name, e.g.
    partial "partials/icon", locals: { name: "github" }

  To add a platform: add a `when "yourplatform"` branch below with its SVG
  path data, then reference that name in data/social.yml.

  aria-hidden="true" is intentional: these icons sit inside links that already
  carry an aria-label, so announcing the icon too would be redundant noise.

  Note: never put an ERB closing tag inside this comment — it would end the
  comment early and dump the rest of it onto the page as visible text.
-%>
<% case name %>
<% when "github" %>
  <i class="fa-brands fa-github"></i>
<% when "linkedin" %>
  <i class="fa-brands fa-linkedin"></i>
<% when "email" %>
  <i class="fa-solid fa-envelope"></i>
<% when "x" %>
  <i class="fa-brands fa-x-twitter"></i>
<% when "instagram" %>
  <i class="fa-brands fa-instagram"></i>
<% when "mastodon" %>
  <svg class="icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false">
    <path d="M11.19 12.195c2.016-.24 3.77-1.475 3.99-2.603.348-1.778.32-4.339.32-4.339 0-3.47-2.286-4.488-2.286-4.488C12.062.238 10.083.017 8.027 0h-.05C5.92.017 3.942.238 2.79.765c0 0-2.285 1.017-2.285 4.488l-.002.662c-.004.64-.007 1.35.011 2.091.083 3.394.626 6.74 3.78 7.57 1.454.383 2.703.463 3.709.408 1.823-.1 2.847-.647 2.847-.647l-.06-1.317s-1.303.41-2.767.36c-1.45-.05-2.98-.156-3.215-1.928a3.614 3.614 0 0 1-.033-.496s1.424.346 3.228.428c1.103.05 2.137-.064 3.188-.189zm1.613-2.47H11.13v-4.08c0-.859-.364-1.295-1.091-1.295-.804 0-1.207.517-1.207 1.541v2.233H7.168V5.89c0-1.024-.403-1.541-1.207-1.541-.727 0-1.091.436-1.091 1.296v4.079H3.197V5.522c0-.858.22-1.54.66-2.046.456-.505 1.052-.764 1.793-.764.856 0 1.504.328 1.933.985l.417.696.417-.696c.429-.657 1.077-.985 1.933-.985.74 0 1.337.259 1.792.764.442.505.661 1.188.661 2.046v4.203z"/>
  </svg>
<% when "dev" %>
  <svg class="icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false">
    <path d="M14.5 2h-13A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h13a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2ZM4.4 10.2c-.26.35-.65.52-1.16.52H2.1V5.28h1.17c.5 0 .89.17 1.15.52.26.35.39.86.39 1.53v1.34c0 .67-.13 1.18-.4 1.53Zm-.68-2.88c0-.33-.06-.55-.17-.66a.6.6 0 0 0-.45-.16h-.05v3h.05a.6.6 0 0 0 .45-.16c.11-.11.17-.33.17-.66V7.32Zm4.2-1.03H6.55v1.24h1.2v1H6.55v1.24h1.37v1.01H5.42V5.28h2.5v1.01Zm3.06 4.45c-.14.32-.31.48-.53.48-.22 0-.4-.16-.53-.48L8.6 5.28h1.2l.65 3.63.66-3.63h1.19l-1.32 5.46Z"/>
  </svg>
<% else %>
  <%# Fallback: a generic link glyph, so an unknown icon name never breaks the page. %>
  <svg class="icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"
       stroke-linecap="round" aria-hidden="true" focusable="false">
    <path d="M6.5 9.5a2.5 2.5 0 0 0 3.5 0l2.5-2.5a2.475 2.475 0 0 0-3.5-3.5l-.5.5"/>
    <path d="M9.5 6.5a2.5 2.5 0 0 0-3.5 0L3.5 9a2.475 2.475 0 0 0 3.5 3.5l.5-.5"/>
  </svg>
<% end %>
