    <path d="M14.5 2h-13A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h13a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2ZM4.4 10.2c-.26.35-.65.52-1.16.52H2.1V5.28h1.17c.5 0 .89.17 1.15.52.26.35.39.86.39 1.53v1.34c0 .67-.13 1.18-.4 1.53Zm-.68-2.88c0-.33-.06-.55-.17-.66a.6.6 0 0 0-.45-.16h-.05v3h.05a.6.6 0 0 0 .45-.16c.11-.11.17-.33.17-.66V7.32Zm4.2-1.03H6.55v1.24h1.2v1H6.55v1.24h1.37v1.01H5.42V5.28h2.5v1.01Zm3.06 4.45c-.14.32-.31.48-.53.48-.22 0-.4-.16-.53-.48L8.6 5.28h1.2l.65 3.63.66-3.63h1.19l-1.32 5.46Z"/>
