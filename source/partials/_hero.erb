<%#
  Hero section: name, role, tagline, and the primary calls to action.
  Content comes from data/about.yml and data/social.yml.
-%>
<section id="hero" class="section section-hero" data-nav-sentinel>
  <div class="container">
    <div class="row align-items-center g-4 g-lg-5">
      <div class="col-lg-7">


        <%# The single <h1> of the page — everything else steps down from here. %>
        <%# Typed.js types into the inner span, so its cursor lands inline inside the h1. %>
        <h1 class="hero-name reveal" data-reveal><span id="hero-name"></span></h1>

        <p class="hero-role reveal" data-reveal><%= data.about.role %></p>

        <p class="hero-tagline reveal" data-reveal><%= data.about.tagline.strip %></p>

        <p class="hero-location reveal" data-reveal>
          <i class="fa-solid fa-location-dot"></i>
          <%= data.about.location %>
        </p>

        <div class="hero-actions reveal" data-reveal>
          <a class="btn btn-primary-solid" href="#projects">View projects</a>
        </div>

      </div>

      <%# Portrait — a small avatar above the name on phones, a large circle on the right from lg up. %>
      <div class="col-4 col-sm-3 col-lg-4 offset-lg-1 order-first order-lg-last">
        <div class="ratio ratio-1x1 bg-body-tertiary rounded-circle reveal" data-reveal>
          <%= image_tag "profile.png", alt: "Memoji of #{data.about.name}", class: "object-fit-contain p-2 p-lg-4" %>
        </div>
      </div>

    </div>
  </div>
</section>
