# Ruby dependencies for the portfolio site. Install with: bundle install

source "https://rubygems.org"

# Static site generator that builds this site.
gem "middleman", "~> 4.5"

# Adds `rake build` and `rake publish` for deploying to a gh-pages branch.
gem "middleman-gh-pages", "~> 0.4"

# Refreshes the browser automatically when you save a file during development.
gem "middleman-livereload", "~> 3.4"

# Task runner used by middleman-gh-pages.
gem "rake", "~> 13.0"

# Ruby 3+ no longer bundles webrick, which `middleman server` needs.
gem "webrick", "~> 1.8"

# Timezone data for platforms that don't ship it with the OS.
gem "tzinfo-data", platforms: %i[mswin mingw jruby x64_mingw]
